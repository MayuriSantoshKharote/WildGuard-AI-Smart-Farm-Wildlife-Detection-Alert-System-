# =========================================================================
# WildGuard AI - Frontend Environment Variables (.env)
# =========================================================================

# 1. Local Development (Default):
VITE_BACKEND_URL=http://localhost:5000
VITE_AI_URL=http://localhost:8000

# 2. Local Network (Testing from Phone on same Wi-Fi, replace with your PC IP):
# VITE_BACKEND_URL=http://192.168.1.100:5000
# VITE_AI_URL=http://192.168.1.100:8000

# 3. Production / Vercel Remote Deployment (HTTPS Public Tunnel):
# VITE_BACKEND_URL=https://wildguard-backend.ngrok-free.app
# VITE_AI_URL=https://wildguard-ai.ngrok-free.app

# Firebase Authentication (Optional)
VITE_FIREBASE_API_KEY=AIzaSyDummyKey_WildGuardAI
VITE_FIREBASE_AUTH_DOMAIN=wildguard-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wildguard-ai
VITE_FIREBASE_STORAGE_BUCKET=wildguard-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-WG99AIINTELLIGENCE
